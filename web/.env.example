# Copy to .env.local and fill in. Never commit .env.local.
# Names only: set real values in .env.local and the Vercel dashboard.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Groq (main LLM: plans, chat, replan, help, food text) ───────────────────
GROQ_API_KEY=
# Optional model overrides; defaults live in src/lib/groq-model.ts
# GROQ_MODEL=
# GROQ_FAST_MODEL=

# ── OpenAI (second provider) ─────────────────────────────────────────────────
# Used by /api/analyze-food (image recognition), /api/analyze-inspiration,
# /api/assistant (embeddings for knowledge search) and /api/seed-knowledge.
# Without it those four features fail; everything else still works.
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# ── ML service (ml-service/, deployed on Render) ─────────────────────────────
ML_SERVICE_URL=http://localhost:8000
# Must match ML_SERVICE_API_KEY in ml-service/.env and Render.
ML_SERVICE_API_KEY=

# ── Food and exercise data ───────────────────────────────────────────────────
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
RAPIDAPI_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Shared secret for POST /api/seed-knowledge (header x-seed-secret)
SEED_SECRET=
# Optional; falls back to VERCEL_URL
# NEXT_PUBLIC_APP_URL=
