# Copy to .env and fill in. Never commit .env.

# Shared bearer token. Must match ML_SERVICE_API_KEY in web/.env.local and Vercel.
ML_SERVICE_API_KEY=replace-with-a-long-random-string

# Where trained artifacts live. Produced by training/, gitignored.
MODEL_DIR=./models

LOG_LEVEL=info

# OPTIONAL. Only set these if you want POST /predict/injury-risk to read
# Supabase itself when a caller sends nothing but a user_id. Next.js normally
# sends the features it already has, in which case leave these unset and the ML
# service holds no database credentials.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
